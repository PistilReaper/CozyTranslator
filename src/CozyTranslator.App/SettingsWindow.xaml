<Window x:Class="CozyTranslator.Desktop.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CozyTranslator · 设置" Width="560" Height="780" MinHeight="520" MinWidth="460" WindowStartupLocation="CenterOwner" Background="{DynamicResource Paper}" ShowInTaskbar="False" ResizeMode="CanResize" Topmost="True" PreviewKeyDown="WindowKeyDown">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="66" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12">
    <Grid Margin="24,22" Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="设置" FontSize="23"/><Button Style="{StaticResource IconButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseClick" AutomationProperties.Name="关闭设置"/></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
        <TextBlock Text="外观" Style="{StaticResource Label}" Margin="0,8,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="主题" Style="{StaticResource Label}" Margin="0,0,0,7"/><ComboBox x:Name="ThemeBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="字号" Style="{StaticResource Label}" Margin="0,0,0,7"/><ComboBox x:Name="FontSizeBox" SelectionChanged="AppearanceChanged" AutomationProperties.Name="字号"><ComboBoxItem Content="16"/><ComboBoxItem Content="18"/><ComboBoxItem Content="20"/><ComboBoxItem Content="22"/><ComboBoxItem Content="24"/></ComboBox></StackPanel>
        </Grid>
        <TextBlock Text="翻译触发" Style="{StaticResource Label}" Margin="0,18,0,7"/><ComboBox x:Name="TriggerBox" AutomationProperties.Name="翻译触发"><ComboBoxItem Content="模式 1 · 复制即翻译"/><ComboBoxItem Content="模式 2 · 右键模式"/><ComboBoxItem Content="仅手动"/></ComboBox><TextBlock Text="右键模式：按住左键选字，再点右键；原文会复制到剪贴板。" FontSize="{DynamicResource SmallSize}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,22,0,14"/>
        <TextBlock Text="模型" Style="{StaticResource Label}" Margin="0,8,0,13"/>
        <ComboBox x:Name="ProtocolBox" SelectionChanged="ProtocolChanged" AutomationProperties.Name="接口协议"><ComboBoxItem Content="OpenAI 兼容 · DeepSeek 等"/><ComboBoxItem Content="Claude · 原生接口"/><ComboBoxItem Content="Gemini · 原生接口"/></ComboBox>
        <TextBlock Text="接口基础地址" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" Margin="0,14,0,6"/><TextBox x:Name="BaseUrlBox" Style="{StaticResource Field}" AutomationProperties.Name="接口基础地址"/>
        <TextBlock Text="模型名称" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" Margin="0,14,0,6"/><TextBox x:Name="ModelBox" Style="{StaticResource Field}" ToolTip="填写服务商提供的准确模型 ID" AutomationProperties.Name="模型名称"/>
        <TextBlock Text="API Key" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" Margin="0,14,0,6"/><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="12,10"><PasswordBox x:Name="KeyBox" BorderThickness="0" Padding="0" MinHeight="24" Background="Transparent" Foreground="{DynamicResource Ink}" FontSize="{DynamicResource UiSize}" AutomationProperties.Name="API Key"/></Border>
        <TextBlock Text="密钥在本机加密保存，文本直接发送至你配置的服务。" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,23,0,19"/>
        <Grid Margin="0,0,0,12"><TextBlock Text="翻译提示词" Style="{StaticResource Label}"/><Button Style="{StaticResource Button}" Padding="8,3" Content="恢复默认" FontSize="{DynamicResource UiSize}" HorizontalAlignment="Right" Click="ResetPromptClick"/></Grid>
        <TextBox x:Name="PromptBox" Style="{StaticResource Field}" AcceptsReturn="True" Height="132" VerticalScrollBarVisibility="Auto" FontSize="{DynamicResource UiSize}" AutomationProperties.Name="翻译系统提示词"/>
        <TextBlock Text="语言方向与五档风格会在翻译时自动加入。" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" Margin="0,9,0,0"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,23,0,19"/>
        <TextBlock Text="全局快捷键" Style="{StaticResource Label}" Margin="0,0,0,12"/>
        <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" AutomationProperties.Name="全局快捷键"/><TextBlock Text="手动唤出并翻译当前剪贴板。" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" Margin="0,8,0,16"/>
      <TextBlock x:Name="VersionText" FontSize="{DynamicResource SmallSize}" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel></ScrollViewer>
      <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="{DynamicResource UiSize}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,12,0,4"/>
      <Grid Grid.Row="3"><Button x:Name="TestButton" Content="测试连接" Style="{StaticResource Button}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="TestClick"/><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="SaveClick"/></Grid>
    </Grid>
  </Border>
</Window>
