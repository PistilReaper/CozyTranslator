<Window x:Class="CozyTranslator.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:rendering="clr-namespace:CozyTranslator.Desktop.Rendering" Title="CozyTranslator" Icon="Assets/cozy.ico" Width="520" Height="700" MinWidth="440" MinHeight="560" Background="{DynamicResource Paper}" ResizeMode="CanResize" ShowInTaskbar="True" Topmost="True" PreviewKeyDown="WindowKeyDown">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="60" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Border Background="{DynamicResource Paper}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Grid Margin="20,18" Background="Transparent">
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="1*" MinHeight="90"/><RowDefinition Height="18"/><RowDefinition Height="1.45*" MinHeight="90"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Border Width="28" Height="28" Background="{DynamicResource AccentSoft}" CornerRadius="8" Margin="0,2,9,0"><TextBlock Text="c" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock x:Name="BrandTitle" Text="Cozy Translator" FontSize="{DynamicResource TitleSize}" FontWeight="Medium"/></StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="PinButton" Style="{StaticResource IconButton}" Foreground="{DynamicResource Accent}" Content="&#xE718;" ToolTip="取消置顶" AutomationProperties.Name="切换置顶" Click="PinClick"/><Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置" Click="SettingsClick"/><Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeClick"/><Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到托盘" Click="HideToTrayClick"/>
        </StackPanel>
      </Grid>
      <WrapPanel Grid.Row="1" Margin="0,0,0,14">
        <Border x:Name="ModeStrip" Background="{DynamicResource Wash}" CornerRadius="10" Padding="3" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="自动" Tag="0" IsChecked="True" Checked="ModeChecked"/><RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="查词" Tag="1" Checked="ModeChecked"/><RadioButton Style="{StaticResource Segment}" GroupName="Mode" Content="翻译" Tag="2" Checked="ModeChecked"/></StackPanel></Border>
        <ComboBox x:Name="DirectionBox" Width="178" VerticalAlignment="Center" SelectedIndex="{Binding DirectionIndex}" SelectionChanged="DirectionChanged" Visibility="{Binding ShowTone,Converter={StaticResource BoolVisible}}" AutomationProperties.Name="翻译方向"><ComboBoxItem Content="自动中英互译"/><ComboBoxItem Content="中文 → 英语"/><ComboBoxItem Content="英语 → 中文"/></ComboBox>
      </WrapPanel>
      <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="原文" Style="{StaticResource Label}" Margin="0,0,0,8"/><Button Style="{StaticResource IconButton}" Content="&#xE894;" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Click="ClearClick" ToolTip="清空" AutomationProperties.Name="清空原文"/>
          <Grid Grid.Row="1"><TextBlock Text="输入或复制文本…" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource BodySize}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox x:Name="SourceEditor" Style="{StaticResource Editor}" Text="{Binding Source,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="原文"/></Grid>
        </Grid>
      </Border>
      <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding ResultLabel}" Style="{StaticResource Label}" Margin="0,0,0,12"/><Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButton}" Content="&#xE8C8;" Margin="0,-5,-4,0" IsEnabled="{Binding CanCopy}" ToolTip="复制结果" AutomationProperties.Name="复制结果" Click="CopyClick"/>
        <Grid Grid.Row="1" Background="Transparent">
          <Button Content="配置模型" Style="{StaticResource Button}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding ShowConnect,Converter={StaticResource BoolVisible}}" Click="SettingsClick"/>
          <rendering:MarkdownView x:Name="ResultEditor" Markdown="{Binding ResultText}" IsStreaming="{Binding Busy}" Background="Transparent" Foreground="{DynamicResource Ink}" SelectionBrush="{DynamicResource AccentSoft}" BorderThickness="0" Padding="0" FontFamily="{StaticResource ReadingFont}" FontSize="{DynamicResource BodySize}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasTranslation,Converter={StaticResource BoolVisible}}" AutomationProperties.Name="译文"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDictionary,Converter={StaticResource BoolVisible}}"><StackPanel Margin="0,0,8,8">
            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE767;" HorizontalAlignment="Right" IsEnabled="{Binding CanSpeak}" Click="SpeakClick" ToolTip="朗读单词" AutomationProperties.Name="朗读单词"/><TextBlock Text="{Binding Word}" FontSize="{DynamicResource WordSize}" FontWeight="Medium" TextWrapping="Wrap"/></DockPanel>
            <ItemsControl ItemsSource="{Binding Phonetics}" Margin="0,10,0,15"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,17,5"><TextBlock Text="{Binding Label}" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" Margin="0,0,7,0"/><TextBlock Text="{Binding Ipa}" FontFamily="Segoe UI" FontSize="{DynamicResource BodySize}" Foreground="{DynamicResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <ItemsControl ItemsSource="{Binding Meanings}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Pos}" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Accent}" Margin="0,3,14,0"/><TextBlock Grid.Column="1" Text="{Binding Definition}" TextWrapping="Wrap" FontSize="{DynamicResource BodySize}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="{Binding WordHint}" TextWrapping="Wrap" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}"/>
          </StackPanel></ScrollViewer>
        </Grid>
      </Grid>
      <Border Grid.Row="5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,8" Visibility="{Binding ShowTone,Converter={StaticResource BoolVisible}}"><StackPanel>
        <Grid><TextBlock Text="表达风格" Style="{StaticResource Label}"/><TextBlock Text="{Binding StyleLabel}" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/></Grid>
        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="专业" VerticalAlignment="Center" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/><Slider x:Name="StyleSlider" Grid.Column="1" Value="{Binding Style,Mode=TwoWay}" Style="{StaticResource ToneSlider}" PreviewMouseLeftButtonUp="StyleCommitted" KeyUp="StyleKeyUp" AutomationProperties.Name="表达风格"/><TextBlock Grid.Column="2" Text="日常" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource UiSize}" Foreground="{DynamicResource Muted}"/></Grid>
      </StackPanel></Border>
      <Grid Grid.Row="6" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" FontSize="{DynamicResource SmallSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Button Grid.Column="1" x:Name="TranslateButton" Click="TranslateClick" Style="{StaticResource Primary}" ToolTip="Ctrl + Enter"><Button.Content><TextBlock Foreground="{StaticResource WhiteInk}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="翻译  ↵"/><Style.Triggers><DataTrigger Binding="{Binding IsDictionary}" Value="True"><Setter Property="Text" Value="查词  ↵"/></DataTrigger><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Text" Value="停止  □"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Button.Content></Button>
      </Grid>
    </Grid>
  </Border>
</Window>
